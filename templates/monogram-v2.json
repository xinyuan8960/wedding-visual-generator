{
  "id": "monogram-v2",
  "design_basis": "names",
  "layout": "diagonal-ampersand",
  "canvas_size": 512,
  "background": "none",
  "ink_color": "#222222",
  "fonts": {
    "initials": { "path": "fonts/CormorantGaramond/CormorantGaramond-VariableFont_wght.ttf", "variations": { "wght": 500 } },
    "ampersand": { "path": "fonts/PinyonScript/PinyonScript-Regular.ttf" },
    "caption": { "path": "fonts/Jost/Jost-VariableFont_wght.ttf", "variations": { "wght": 300 } }
  },
  "block": { "size": 0.62, "top": 0.06 },
  "arc": {
    "center": [0.56, 0.52],
    "radius": 0.47,
    "start_deg": -95,
    "end_deg": 155,
    "hairline_ratio": 0.0026,
    "clearance_ratio": 0.012
  },
  "names": { "cap_height": 0.034, "tracking_em": 0.28, "gap_below_block": 0.11, "max_width": 0.86 },
  "date": { "cap_height": 0.024, "tracking_em": 0.22, "gap_below_names": 0.07, "format": "MM.DD.YYYY" }
}
